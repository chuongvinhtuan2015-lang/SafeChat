<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <application
        android:name=".SafeChatApplication"
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="SafeChat"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.SafeChat">


        <activity
            android:name=".ui.splash.ChoActivity"
            android:exported="true"
            android:theme="@style/Theme.SafeChat.Splash">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity android:name=".ui.auth.DangNhapActivity"
            android:exported="false"/>
        <activity android:name=".ui.auth.DangKyActivity"
            android:exported="false"/>
        <activity android:name=".ui.home.ChungActivity"
            android:exported="false"/>

    </application>

</manifest>
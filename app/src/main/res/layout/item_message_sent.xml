<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="12dp"
    android:gravity="end"
    android:orientation="vertical">

    <!-- Bong bóng tin nhắn xanh bên phải -->
    <com.google.android.material.card.MaterialCardView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="64dp"
        app:cardBackgroundColor="#2563EB"
        app:cardCornerRadius="18dp"
        app:cardElevation="2dp"
        app:shapeAppearanceOverlay="@style/ShapeAppearance.SafeChat.BubbleSent"
        app:strokeWidth="0dp">

        <TextView
            android:id="@+id/tvMessageSent"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:lineSpacingExtra="2dp"
            android:paddingHorizontal="16dp"
            android:paddingVertical="12dp"
            android:text="Tôi vừa hoàn thiện bản đầu tiên. Cậu xem giúp tôi nhé!"
            android:textColor="#FFFFFF"
            android:textSize="15sp" />
    </com.google.android.material.card.MaterialCardView>

    <!-- Cụm giờ + dấu tick đã nhận (✓) -->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:layout_marginEnd="4dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/tvTimeSent"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="09:33"
            android:textColor="#94A3B8"
            android:textSize="11sp" />

        <ImageView
            android:id="@+id/ivTick"
            android:layout_width="14dp"
            android:layout_height="14dp"
            android:layout_marginStart="4dp"
            android:src="@drawable/ic_check"
            app:tint="#2563EB" />
    </LinearLayout>

</LinearLayout>
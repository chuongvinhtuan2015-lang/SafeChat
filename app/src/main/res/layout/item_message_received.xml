<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="12dp"
    android:gravity="start"
    android:orientation="vertical">

    <!-- Tên người gửi: Dùng cho chat nhóm, ẩn khi chat 1-1 -->
    <TextView
        android:id="@+id/tvSenderMemberName"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="4dp"
        android:layout_marginBottom="4dp"
        android:text="Hoàng"
        android:textColor="#2563EB"
        android:textSize="12sp"
        android:textStyle="bold"
        android:visibility="gone" />

    <!-- Bong bóng tin nhắn màu trắng, tự bo góc và tạo viền trực tiếp không cần drawable -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/cardBubbleReceived"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="64dp"
        app:cardBackgroundColor="#FFFFFF"
        app:cardCornerRadius="18dp"
        app:cardElevation="1dp"
        app:strokeColor="#F1F5F9"
        app:strokeWidth="1dp">

        <TextView
            android:id="@+id/tvMessageContent"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:lineSpacingExtra="2dp"
            android:paddingHorizontal="16dp"
            android:paddingVertical="12dp"
            android:text="Chào bạn, nội dung tin nhắn hiển thị ở đây."
            android:textColor="#1E293B"
            android:textSize="15sp" />
    </com.google.android.material.card.MaterialCardView>

    <!-- Thời gian tin nhắn -->
    <TextView
        android:id="@+id/tvMessageTime"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="4dp"
        android:layout_marginTop="4dp"
        android:text="08:15"
        android:textColor="#94A3B8"
        android:textSize="11sp" />

</LinearLayout>
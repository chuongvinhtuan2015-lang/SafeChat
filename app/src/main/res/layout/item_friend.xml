<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="?attr/selectableItemBackground"
    android:clickable="true"
    android:focusable="true"
    android:paddingHorizontal="20dp"
    android:paddingVertical="12dp">

    <!-- Avatar tròn -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/cardAvatar"
        android:layout_width="48dp"
        android:layout_height="48dp"
        app:cardBackgroundColor="#EDE9FE"
        app:cardCornerRadius="24dp"
        app:cardElevation="0dp"
        app:strokeWidth="0dp"
        app:layout_constraintBottom_toTopOf="@id/dividerLine"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <TextView
            android:id="@+id/tvAvatarChar"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:text="H"
            android:textColor="#7C3AED"
            android:textSize="16sp"
            android:textStyle="bold" />
    </com.google.android.material.card.MaterialCardView>

    <!-- Tên bạn bè -->
    <TextView
        android:id="@+id/tvFriendName"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="14dp"
        android:layout_marginEnd="12dp"
        android:text="Hoàng"
        android:textColor="#0F172A"
        android:textSize="16sp"
        android:textStyle="bold"
        app:layout_constraintBottom_toTopOf="@id/dividerLine"
        app:layout_constraintEnd_toStartOf="@id/btnDeleteFriend"
        app:layout_constraintStart_toEndOf="@id/cardAvatar"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- Nút Xóa bạn (Nền đỏ nhạt, viền đỏ, icon đỏ đậm #DC2626 rõ ràng) -->
    <!-- Nút Xóa bạn -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/btnDeleteFriend"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:layout_marginEnd="10dp"
        android:clickable="true"
        android:focusable="true"
        android:contentDescription="Xóa bạn"
        app:cardBackgroundColor="#FEF2F2"
        app:cardCornerRadius="12dp"
        app:cardElevation="0dp"
        app:strokeColor="#FECACA"
        app:strokeWidth="1dp"
        app:layout_constraintBottom_toTopOf="@id/dividerLine"
        app:layout_constraintEnd_toStartOf="@id/btnMessageDirect"
        app:layout_constraintTop_toTopOf="parent">

        <ImageView
            android:layout_width="18dp"
            android:layout_height="18dp"
            android:layout_gravity="center"
            android:importantForAccessibility="no"
            android:src="@drawable/ic_delete"
            app:tint="#DC2626" />
    </com.google.android.material.card.MaterialCardView>
    <!-- Nút Nhắn tin nhanh (Nền xanh đặc trưng #2563EB, icon trắng) -->
    <!-- Nút Nhắn tin nhanh -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/btnMessageDirect"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:clickable="true"
        android:focusable="true"
        android:contentDescription="Nhắn tin"
        app:cardBackgroundColor="#2563EB"
        app:cardCornerRadius="12dp"
        app:cardElevation="1dp"
        app:strokeWidth="0dp"
        app:layout_constraintBottom_toTopOf="@id/dividerLine"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <ImageView
            android:layout_width="18dp"
            android:layout_height="18dp"
            android:layout_gravity="center"
            android:importantForAccessibility="no"
            android:src="@drawable/ic_chat_bubble"
            app:tint="#FFFFFF" />
    </com.google.android.material.card.MaterialCardView>
    <!-- Gạch mờ phân cách -->
    <View
        android:id="@+id/dividerLine"
        android:layout_width="0dp"
        android:layout_height="1dp"
        android:layout_marginTop="14dp"
        android:background="#F1F5F9"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="@id/cardAvatar" />

</androidx.constraintlayout.widget.ConstraintLayout>
<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="?attr/selectableItemBackground"
    android:clickable="true"
    android:focusable="true"
    android:paddingHorizontal="20dp"
    android:paddingVertical="12dp">

    <!-- Avatar tròn bo góc 24dp (đường kính 48dp) -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/cardAvatar"
        android:layout_width="48dp"
        android:layout_height="48dp"
        app:cardBackgroundColor="#F1F5F9"
        app:cardCornerRadius="24dp"
        app:cardElevation="0dp"
        app:strokeWidth="0dp"
        app:layout_constraintBottom_toTopOf="@id/dividerLine"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <!-- Ký tự đại diện khi chưa có ảnh -->
        <TextView
            android:id="@+id/tvAvatarChar"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:text="U"
            android:textColor="#64748B"
            android:textSize="16sp"
            android:textStyle="bold" />

        <!-- Ảnh đại diện thật -->
        <ImageView
            android:id="@+id/imgBlockedAvatar"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="centerCrop"
            android:visibility="gone"
            tools:ignore="ContentDescription" />

    </com.google.android.material.card.MaterialCardView>

    <!-- Tên và nhãn phụ -->
    <LinearLayout
        android:id="@+id/layoutUserInfo"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="14dp"
        android:layout_marginEnd="12dp"
        android:orientation="vertical"
        app:layout_constraintBottom_toTopOf="@id/dividerLine"
        app:layout_constraintEnd_toStartOf="@id/btnUnblock"
        app:layout_constraintStart_toEndOf="@id/cardAvatar"
        app:layout_constraintTop_toTopOf="parent">

        <TextView
            android:id="@+id/tvBlockedName"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="Người dùng"
            android:textColor="#0F172A"
            android:textSize="16sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvBlockedStatus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="Đã chặn tin nhắn"
            android:textColor="#94A3B8"
            android:textSize="12sp" />
    </LinearLayout>

    <!-- Nút Bỏ chặn bo góc tinh tế -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/btnUnblock"
        android:layout_width="wrap_content"
        android:layout_height="36dp"
        android:clickable="true"
        android:contentDescription="Bỏ chặn"
        android:focusable="true"
        app:cardBackgroundColor="#CBD5E1"
        app:cardCornerRadius="10dp"
        app:cardElevation="0dp"

        app:layout_constraintBottom_toTopOf="@id/dividerLine"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:gravity="center"
            android:paddingHorizontal="14dp"
            android:text="Bỏ chặn"
            android:textColor="#475569"
            android:textSize="13sp"
            android:textStyle="bold" />
    </com.google.android.material.card.MaterialCardView>

    <!-- Gạch mờ phân cách -->
    <View
        android:id="@+id/dividerLine"
        android:layout_width="0dp"
        android:layout_height="1dp"
        android:layout_marginTop="14dp"
        android:background="#F1F5F9"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="@id/cardAvatar" />

</androidx.constraintlayout.widget.ConstraintLayout>